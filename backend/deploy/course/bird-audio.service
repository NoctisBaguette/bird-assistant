[Unit]
Description=Bird Assistant recording analysis API
After=network-online.target
Wants=network-online.target

[Service]
User=bird-business
Group=bird-business
WorkingDirectory=/opt/bird-assistant/backend
EnvironmentFile=/etc/bird-assistant/audio.env
ExecStart=/opt/bird-assistant/venv/bin/uvicorn bird_audio.app:app --host 127.0.0.1 --port 8201 --workers 1
StateDirectory=bird-audio
UMask=0077
Restart=on-failure
RestartSec=4
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
