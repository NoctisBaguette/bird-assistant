:host{display:block}.works{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px;margin:12px 0;--ink:#406847}.works-lake{--ink:#426e82}.works-sunset{--ink:#975e46}.work{position:relative;min-width:0;min-height:105px;padding:0;margin:0;overflow:hidden;border-radius:15px;text-align:left;background:linear-gradient(135deg,var(--ink),#203c33);transition:transform .16s ease}.work::after{border:0}.lead{grid-column:1/-1;min-height:145px}.photo,.wash{position:absolute;top:0;left:0;width:100%;height:100%}.wash{background:linear-gradient(0deg,rgba(14,34,27,.88),rgba(14,34,27,.05) 90%)}.caption{position:absolute;bottom:12px;left:14px;right:14px;line-height:1.35;color:#fff;text-align:left}.caption text{display:block}.kind,.date{font-size:10px;letter-spacing:1px}.name{font-size:16px;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.lead .name{font-size:20px}.press{transform:scale(.98)}
