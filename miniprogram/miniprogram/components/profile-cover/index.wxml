<view class="identity-card theme-{{theme}}">
  <view class="landscape">
    <image class="cover-photo" style="top:{{-focus * .45}}%;height:145%" src="{{customImage || '/assets/covers/' + cover + '.jpg'}}" mode="aspectFill" aria-hidden="true"/>
    <view class="cover-shade"/>
    <button wx:if="{{editable && showCoverButton}}" class="cover-control" bindtap="changeCover" hover-class="pressed">换封面</button>
  </view>
  <view class="identity-body">
    <view class="identity-top"><view class="portrait"><profile-avatar avatar="{{avatar}}" name="{{name}}" size="72"/></view>
      <button wx:if="{{editable}}" class="edit-control" bindtap="editProfile" hover-class="pressed">{{action}}</button>
    </view>
    <view class="identity-name">{{name}}</view><view wx:if="{{subtitle}}" class="identity-sub">{{subtitle}}</view>
    <view wx:if="{{bio}}" class="identity-bio">{{bio}}</view>
    <view wx:if="{{tags.length || status}}" class="tag-strip"><text wx:if="{{status}}" class="current-status">● {{status}}</text><text wx:for="{{tags}}" wx:key="*this" class="nature-tag">{{item}}</text></view>
  </view>
</view>
