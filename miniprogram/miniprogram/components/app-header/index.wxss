.header{font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","HarmonyOS Sans SC","Microsoft YaHei",sans-serif}
.header{position:fixed;z-index:90;top:0;left:0;right:0;box-sizing:border-box;background:#f4f7f5;display:flex;align-items:center;gap:10px;padding-left:16px;color:#1c3028}
.leaf{width:22px;height:22px;flex:none}.heading{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:18px;font-weight:600;line-height:1.4;letter-spacing:0}
.subheading{font-size:16px;font-weight:500}.back{display:flex;align-items:center;justify-content:center;box-sizing:border-box;flex:0 0 44px;width:44px;min-width:44px;max-width:44px;height:44px;padding:10px;margin:0 0 0 -8px;border:0;border-radius:50%;background:transparent}.back::after{border:0}.back-icon{display:block;width:22px;height:22px;flex:none}
