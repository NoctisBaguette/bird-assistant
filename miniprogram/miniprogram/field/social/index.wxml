<page-meta page-style="{{settingsOpen || (registered && (screen === 'chat' || screen === 'group')) ? 'overflow:hidden;' : 'overflow:auto;'}}"/>
<app-header title="{{pageTitle}}" back bindback="back"/>
<view class="page social {{registered && (screen === 'chat' || screen === 'group') ? 'chat-page' : ''}} {{keyboardOpen ? 'keyboard-open' : ''}}" style="{{registered && (screen === 'chat' || screen === 'group') ? 'top:'+chatTop+'px;height:'+chatHeight+'px' : ''}}">
  <view wx:if="{{localError}}" class="note error" role="alert">{{localError}}<view class="tiny">当前文字仍保留在页面中。</view></view>
  <view wx:if="{{error}}" class="note error">{{error}} <button size="mini" bindtap="start">重新加载</button></view>
  <view wx:if="{{!ready}}" class="note">正在获取账号…</view>
  <view wx:elif="{{!active}}" class="card">
    <view class="title">加入鸟友社区</view><view class="muted">使用当前微信账号登录，首次登录可创建鸟友号。</view>
    <button class="primary" loading="{{working}}" bindtap="login">微信登录 / 注册</button>
  </view>
  <view wx:elif="{{error && !registered && !self}}" class="note">请重新加载账号资料。</view>
  <view wx:elif="{{!registered || editing}}" class="card">
    <view class="title">{{registered ? '编辑社区资料' : '创建鸟友账号'}}</view>
    <view class="label">社区昵称</view><input maxlength="24" value="{{form.nickname}}" data-field="nickname" bindinput="formInput" placeholder="鸟友看到的名字" />
    <view class="label">鸟友号</view><input maxlength="24" value="{{form.handle}}" data-field="handle" bindinput="formInput" placeholder="3–24 位字母、数字或下划线" />
    <view class="label">个人简介</view><textarea maxlength="160" value="{{form.bio}}" data-field="bio" bindinput="formInput" placeholder="喜欢在哪里观鸟？" />
    <view class="label">社区头像</view><view class="choices"><button wx:for="{{avatars}}" wx:key="*this" class="avatar-choice {{form.avatar === item ? 'picked' : ''}}" data-field="avatar" data-value="{{item}}" bindtap="choice"><profile-avatar avatar="{{item}}" name="{{form.nickname}}" size="42"/></button></view>
    <view class="line"><text>允许通过鸟友号或昵称搜索</text><switch checked="{{form.discoverable}}" bindchange="toggleSearch" color="#285b49" /></view>
    <view class="label">允许谁发私信</view><view class="choices"><button class="{{form.dm === 'friends' ? 'picked' : ''}}" data-field="dm" data-value="friends" bindtap="choice">好友</button><button class="{{form.dm === 'everyone' ? 'picked' : ''}}" data-field="dm" data-value="everyone" bindtap="choice">所有鸟友</button></view>
    <view class="label">谁能查看我收藏的公开内容</view><view class="choices"><button wx:for="{{visibilities}}" wx:key="*this" class="{{form.bookmarks === item ? 'picked' : ''}}" data-field="bookmarks" data-value="{{item}}" bindtap="choice">{{visibilityNames[index]}}</button></view>
    <button class="primary" bindtap="save" loading="{{working}}">{{registered ? '保存修改' : '完成注册'}}</button>
    <button wx:if="{{editing}}" bindtap="cancel">取消</button><button wx:else bindtap="logout">退出本机账号</button>
  </view>
  <block wx:elif="{{screen === 'account'}}"><view class="note account-identity-note">社区账号绑定当前微信登录身份。同一微信账号换手机后，昵称、头像、好友和聊天从同一账号读取；匿名帖只隐藏署名。微信昵称和头像需要本人选择，不会自动读取。</view>
    <profile-cover cover="{{account.avatar === 'water' ? 'waterside' : 'woodland'}}" avatar="{{account.avatar}}" name="{{account.nickname}}" subtitle="@{{account.handle}}" bio="{{account.bio}}"/>
    <button class="primary" bindtap="edit">编辑社区资料与隐私</button>
    <view class="choices"><button data-screen="member" data-id="{{self}}" bindtap="go">我的主页</button><button data-screen="friends" bindtap="go">我的好友</button><button data-screen="inbox" bindtap="go">私信与通知</button><button data-screen="groups" bindtap="go">我的群聊</button><button data-screen="blocked" bindtap="go">屏蔽名单</button></view>
    <button class="quiet" bindtap="copyAccountIdentity">复制账号核对信息</button><view class="tiny">两台设备的社区ID应一致；昵称不是登录凭据。核对信息不含登录令牌、微信OpenID或聊天内容。</view><button bindtap="logout">退出本机账号</button>
  </block>
  <block wx:elif="{{screen === 'friends'}}"><view class="my-friend-code"><profile-avatar avatar="{{account.avatar}}" name="{{account.nickname}}" size="36"/><view><text>我的鸟友号</text><text>@{{account.handle}}</text></view><button bindtap="copyHandle">复制鸟友号</button></view>
    <view class="line"><input maxlength="64" value="{{term}}" data-field="term" bindinput="input" bindconfirm="search" placeholder="搜索昵称或完整鸟友号"/><button bindtap="search" disabled="{{working || !term}}" loading="{{working}}">搜索</button></view>
    <view wx:if="{{searched}}" class="card"><view class="strong">搜索结果</view><button class="friend-search-result" wx:for="{{matches}}" wx:key="id" data-screen="member" data-id="{{item.id}}" bindtap="go"><profile-avatar avatar="{{item.avatar}}" name="{{item.nickname}}" size="36"/><view><text>{{item.nickname}}</text><text>@{{item.handle}}</text></view><image src="/assets/icons/arrow.png"/></button><view wx:if="{{!matches.length}}" class="muted">没有找到可搜索的鸟友。</view></view>
    <view class="social-tabs"><button class="{{friendTab === 'accepted' ? 'social-tab-on' : ''}}" data-tab="accepted" bindtap="friendTab">鸟友 {{accepted.length}}</button><button class="{{friendTab === 'incoming' ? 'social-tab-on' : ''}}" data-tab="incoming" bindtap="friendTab">收到申请 {{incoming.length}}</button><button class="{{friendTab === 'outgoing' ? 'social-tab-on' : ''}}" data-tab="outgoing" bindtap="friendTab">已发申请 {{outgoing.length}}</button></view>
    <block wx:if="{{friendTab === 'incoming'}}"><view class="social-section-copy">认识新鸟友<text>接受后成为好友；你的私信权限仍由账号设置决定。</text></view><view class="friend-card" wx:for="{{incoming}}" wx:key="id"><view class="friend-identity" data-screen="member" data-id="{{item.id}}" bindtap="go"><profile-avatar avatar="{{item.avatar}}" name="{{item.nickname}}" size="44"/><view><text class="friend-name">{{item.nickname}}</text><text class="friend-handle">@{{item.handle}}</text></view><text class="friend-state">待你确认</text></view><view class="friend-actions"><button class="friend-accept" disabled="{{working}}" data-op="accept" data-id="{{item.id}}" bindtap="mutate">接受申请</button><button disabled="{{working}}" data-op="decline" data-id="{{item.id}}" bindtap="mutate">暂不接受</button></view></view><view wx:if="{{!incoming.length}}" class="social-empty">暂时没有新申请</view></block>
    <block wx:elif="{{friendTab === 'outgoing'}}"><view class="social-section-copy">等待回应<text>申请不会直接打开私信权限，也不会自动把对方加入群聊。</text></view><view class="friend-card" wx:for="{{outgoing}}" wx:key="id"><view class="friend-identity" data-screen="member" data-id="{{item.id}}" bindtap="go"><profile-avatar avatar="{{item.avatar}}" name="{{item.nickname}}" size="44"/><view><text class="friend-name">{{item.nickname}}</text><text class="friend-handle">@{{item.handle}}</text></view></view><view class="friend-actions"><text>等待对方确认</text><button disabled="{{working}}" data-op="cancel" data-id="{{item.id}}" bindtap="mutate">撤回申请</button></view></view><view wx:if="{{!outgoing.length}}" class="social-empty">没有等待中的申请</view></block>
    <block wx:else><view wx:for="{{accepted}}" wx:key="id" class="friend-card"><view class="friend-identity" data-screen="member" data-id="{{item.id}}" bindtap="go"><profile-avatar avatar="{{item.avatar}}" name="{{item.nickname}}" size="44"/><view><text class="friend-name">{{item.nickname}}</text><text class="friend-handle">@{{item.handle}}</text></view><button class="friend-message" data-screen="chat" data-id="{{item.id}}" catchtap="go" aria-label="私信{{item.nickname}}"><image src="/assets/icons/chat.png"/></button></view></view><view wx:if="{{!accepted.length}}" class="social-empty"><view>还没有鸟友</view><text>搜索鸟友号，或从讨论作者主页发起申请。</text></view></block>
  </block>
  <block wx:elif="{{screen === 'member' && member}}">
    <profile-cover cover="{{member.showcase.layout.landscape}}" custom-image="{{member.showcase.coverImage}}" focus="{{member.showcase.layout.focus}}" theme="{{member.showcase.layout.theme}}" tags="{{member.showcase.layout.tags}}" status="{{member.showcase.layout.status}}" avatar="{{member.profile.avatar}}" name="{{member.profile.nickname}}" subtitle="{{member.profile.handle ? '@' + member.profile.handle : ''}}" bio="{{member.profile.bio}}"/>
    <text wx:if="{{member.showcase.coverNotice}}" class="tiny">{{member.showcase.coverNotice}}</text>
    <profile-works items="{{member.showcase.items}}" theme="{{member.showcase.layout.theme}}"/>
    <view wx:if="{{id !== self}}" class="choices member-actions">
      <button wx:if="{{member.registered && member.relationship === 'none'}}" class="picked" data-op="request" bindtap="mutate">申请加好友</button>
      <button wx:if="{{member.relationship === 'incoming'}}" data-op="accept" bindtap="mutate">接受申请</button><button wx:if="{{member.relationship === 'incoming'}}" data-op="decline" bindtap="mutate">拒绝</button>
      <button wx:if="{{member.relationship === 'outgoing'}}" data-op="cancel" bindtap="mutate">等待确认 · 撤回</button><button wx:if="{{member.canMessage}}" data-screen="chat" data-id="{{id}}" bindtap="go">发私信</button>
      <button class="member-more" bindtap="toggleRelationshipMenu" aria-expanded="{{relationshipMenu}}">更多</button>
    </view>
    <view wx:if="{{id !== self && relationshipMenu}}" class="choices"><button wx:if="{{member.relationship === 'friends'}}" data-op="remove" bindtap="mutate">移除好友</button><button data-op="block" bindtap="mutate">屏蔽</button></view>
    <view class="member-tabs"><button data-tab="posts" class="{{memberTab === 'posts' ? 'member-tab-active' : ''}}" bindtap="selectMemberTab">帖子</button><button data-tab="map" class="{{memberTab === 'map' ? 'member-tab-active' : ''}}" bindtap="selectMemberTab">地图鸟讯</button><button wx:if="{{member.showBookmarks}}" data-tab="bookmarks" class="{{memberTab === 'bookmarks' ? 'member-tab-active' : ''}}" bindtap="selectMemberTab">书签</button></view>
    <view wx:if="{{memberTab === 'map'}}" class="tiny member-map-note">{{member.mapAvailable ? '最近的署名公开鸟讯 · 地点按公开精度显示' : '当前服务暂未提供按作者查看鸟讯，可从首页地图查看公开记录。'}}</view>
    <view class="member-feed"><button wx:for="{{memberTab === 'bookmarks' ? member.bookmarks : memberTab === 'map' ? member.mapRecords : member.posts}}" wx:key="id" class="member-post" data-screen="record" data-id="{{item.id}}" bindtap="go" hover-class="press-feedback">
      <view class="member-thumb"><image wx:if="{{item.thumb}}" src="{{item.thumb}}" mode="aspectFill" lazy-load/><image wx:else class="member-glyph" src="/assets/icons/journal.png"/></view><view class="member-copy"><text>{{item.title || item.speciesName || '观鸟记录'}}</text><view>{{item.date || item.publicName}}</view></view><image class="member-arrow" src="/assets/icons/arrow.png"/></button></view>
    <view wx:if="{{memberTab === 'posts' ? !member.posts.length : memberTab === 'map' ? member.mapAvailable && !member.mapRecords.length : !member.bookmarks.length}}" class="empty">{{memberTab === 'posts' ? '还没有公开的署名帖子。' : memberTab === 'map' ? '还没有署名公开的地图鸟讯。私人观察不会因添加好友而公开。' : '还没有收藏的公开内容。'}}</view>
  </block>
  <block wx:elif="{{screen === 'inbox'}}">
    <block wx:if="{{identifications.length}}"><view class="section-title">我的求鉴定帖</view><button wx:for="{{identifications}}" wx:key="post" class="conversation" data-screen="record" data-id="{{item.post}}" bindtap="go"><text>{{item.title}}</text><text class="excerpt">{{item.poll.result ? '已采纳 '+item.poll.result.name : '已有鸟友参与鉴定'}} · {{item.poll.total}} 票</text></button></block>
    <view class="notification-tools"><button bindtap="friendRequests" hover-class="press-feedback"><image src="/assets/icons/user.png"/><text>好友申请</text><text class="notification-count">{{incoming.length}}</text></button><button data-screen="groups" bindtap="go" hover-class="press-feedback"><image src="/assets/icons/chat.png"/><text>群聊邀请</text><text class="notification-count">{{invites.length}}</text></button></view>
    <view class="inbox-section-heading"><view class="section-title">最近私信</view><button class="text-button" bindtap="hidden">{{showHidden ? '收起已隐藏' : '查看已隐藏'}}</button></view>
    <view class="inbox-entry {{item.pinned ? 'inbox-pinned' : ''}}" wx:for="{{inbox}}" wx:key="peer"><button class="conversation conversation-with-avatar" data-screen="chat" data-id="{{item.peer}}" bindtap="go" hover-class="press-feedback"><profile-avatar avatar="{{item.profile.avatar}}" name="{{item.profile.nickname}}" size="42"/><view class="conversation-copy"><view class="conversation-title"><text>{{item.alias || item.profile.nickname}}</text><text wx:if="{{item.unread && !item.quiet}}" class="unread">{{item.unread > 99 ? '99+' : item.unread}}</text></view><text class="excerpt {{item.hasDraft ? 'draft-excerpt' : ''}}">{{item.excerpt || item.body}}</text><text class="tiny">{{item.pinned ? '置顶 · ' : ''}}{{item.quiet ? '本机不提示未读 · ' : ''}}{{item.timeLabel}}</text></view></button><button class="inbox-hide" data-id="{{item.peer}}" bindtap="toggleHiddenConversation">{{item.hidden ? '恢复显示' : '隐藏'}}</button></view>
    <view wx:if="{{!inbox.length}}" class="social-empty"><image src="/assets/icons/chat.png"/><view>这里暂时没有会话</view><text>从鸟友主页发起对话。隐藏的私信收到新消息后会重新出现。</text></view>
    <view wx:if="{{groups.length}}" class="section-title">我的群聊</view><button class="group-row" wx:for="{{groups}}" wx:key="id" data-screen="group" data-id="{{item.id}}" bindtap="go"><image class="group-symbol" src="/assets/icons/chat.png"/><text class="group-label">{{item.alias || item.name}}</text><text wx:if="{{item.unread && !item.quiet}}" class="unread">{{item.unread}} 条未读</text></button>
    <view class="inbox-section-heading"><view class="section-title">帖子收到的回复</view><button wx:if="{{showHidden}}" class="text-button" bindtap="restoreNotifications">恢复通知</button></view>
    <view class="activity-row" wx:for="{{activity}}" wx:key="id"><button class="conversation" data-screen="record" data-id="{{item.post}}" bindtap="go" hover-class="press-feedback"><text class="strong">{{item.nickname}}</text><text class="excerpt">{{item.body}}</text><text class="tiny">{{item.timeLabel}}{{item.hidden ? ' · 本机已隐藏' : ''}}</text></button><button wx:if="{{!item.hidden}}" class="inbox-hide" data-id="{{item.id}}" bindtap="hideActivity">隐藏通知</button></view><view wx:if="{{!activity.length}}" class="social-empty compact-social-empty">还没有公开回复通知</view>
    <view class="tiny spaced">隐藏只影响本机列表，保留消息和回复原件。</view>
  </block>
  <block wx:elif="{{screen === 'groups'}}"><view class="social-section-copy">一起去看鸟<text>邀请须由对方确认；群内消息仅对成员开放。</text></view>
    <view class="line group-create"><input value="{{groupName}}" data-field="groupName" bindinput="input" placeholder="新群聊名称" maxlength="40"/><button bindtap="createGroup" loading="{{working}}">建群</button></view>
    <view wx:if="{{invites.length}}" class="section-title">群聊邀请</view><view wx:for="{{invites}}" wx:key="id" class="card">{{item.name}}<view class="choices"><button data-id="{{item.id}}" data-op="join" bindtap="mutate">加入</button><button data-id="{{item.id}}" data-op="reject" bindtap="mutate">拒绝</button></view></view>
    <view class="section-title">已加入的群聊</view><button class="group-row" wx:for="{{groups}}" wx:key="id" data-screen="group" data-id="{{item.id}}" bindtap="go"><image class="group-symbol" src="/assets/icons/chat.png"/><text class="group-label">{{item.alias || item.name}}</text><text wx:if="{{item.unread && !item.quiet}}" class="unread">{{item.unread}} 条未读</text></button><view wx:if="{{!groups.length}}" class="muted">创建一个群聊，再邀请鸟友加入。</view>
  </block>
  <block wx:elif="{{screen === 'forward'}}">
    <view class="social-section-copy">把发现带给鸟友<text>选择一位好友或已加入的群聊，确认后再发送。仅能转发公开内容。</text></view>
    <view wx:if="{{forwardShare}}" class="forward-preview"><text>公开内容</text><view>{{forwardShare.title}}</view><button class="text-button" data-screen="record" data-id="{{forwardShare.id}}" bindtap="go">查看原帖</button></view>
    <view wx:if="{{forwardReceipt}}" class="forward-receipt" role="status">{{forwardReceipt}}</view>
    <view wx:if="{{forwardTarget}}" class="forward-confirm"><view>发送给 <text>{{forwardTarget.name}}</text></view><button class="primary" bindtap="sendForward" loading="{{working}}" disabled="{{working || !forwardShare}}">确认转发</button></view>
    <view class="section-title">我的鸟友</view><button wx:for="{{accepted}}" wx:key="id" class="forward-target {{forwardTarget.kind === 'chat' && forwardTarget.id === item.id ? 'target-picked' : ''}}" data-kind="chat" data-id="{{item.id}}" bindtap="chooseForward" disabled="{{working}}"><profile-avatar avatar="{{item.avatar}}" name="{{item.nickname}}" size="36"/><text>{{item.nickname}}</text><image src="/assets/icons/arrow.png"/></button>
    <view class="section-title">已加入的群聊</view><button wx:for="{{groups}}" wx:key="id" class="forward-target {{forwardTarget.kind === 'group' && forwardTarget.id === item.id ? 'target-picked' : ''}}" data-kind="group" data-id="{{item.id}}" bindtap="chooseForward" disabled="{{working}}"><image class="forward-group" src="/assets/icons/chat.png"/><text>{{item.alias || item.name}}</text><image src="/assets/icons/arrow.png"/></button>
    <view wx:if="{{!accepted.length && !groups.length && ready}}" class="social-empty">先添加鸟友或加入群聊，再从这里转发。</view>
  </block>
  <block wx:elif="{{screen === 'chat' || screen === 'group'}}">
    <view class="chat-heading"><button wx:if="{{screen === 'chat'}}" class="chat-peer" data-screen="member" data-id="{{id}}" bindtap="go"><profile-avatar avatar="{{member.profile.avatar || 'letter'}}" name="{{pageTitle}}" size="32"/><view><text>{{prefs.alias || pageTitle}}</text><text>私信 · 仅双方可见</text></view></button><view wx:else class="chat-group-title"><text>{{prefs.alias || pageTitle}}</text><text>{{group ? group.members.length+'位成员' : '正在读取群聊'}} · 仅成员可见</text></view><button class="chat-settings" bindtap="openSettings" aria-label="打开会话设置"><image src="/assets/icons/settings.png"/></button></view>
    <scroll-view class="chat-messages" scroll-y enhanced bounces="{{false}}" scroll-into-view="{{messageAnchor}}" bindscroll="messageScrolled" aria-label="聊天记录">
      <view class="message-history">
        <button wx:if="{{earlier}}" class="text-button older-messages" bindtap="older" disabled="{{working}}">加载更早的消息</button>
        <view wx:if="{{!lines.length}}" class="chat-empty"><image src="/assets/icons/chat.png"/><text>从一句问候开始</text><text>消息仅对会话成员可见</text></view>
        <view wx:for="{{lines}}" wx:key="id" id="message-{{item.id}}" class="message-row {{item.sender === self ? 'message-own' : ''}}" data-id="{{item.id}}" bindlongpress="messageActions">
          <profile-avatar avatar="{{item.sender === self ? account.avatar : screen === 'chat' ? member.profile.avatar : 'letter'}}" name="{{item.sender === self ? account.nickname : item.nickname || member.profile.nickname}}" size="34"/>
          <view class="message-copy"><view class="message-byline"><text wx:if="{{screen === 'group' && item.sender !== self}}">{{item.nickname || '鸟友'}}</text><text>{{item.timeLabel}}</text></view><view class="bubble {{item.sender === self ? 'own' : ''}}"><button wx:if="{{item.share}}" class="message-share-card" data-id="{{item.id}}" bindtap="openShared"><text>羽迹 · 公开内容</text><view>{{item.share.title}}</view><text>打开原帖 ›</text></button><text wx:else selectable="true">{{item.body}}</text></view></view>
        </view><view id="message-end-a" class="message-end"/><view id="message-end-b" class="message-end"/>
      </view>
    </scroll-view>
    <button wx:if="{{newMessages}}" class="new-messages" bindtap="latestMessages">{{newMessages}}条新消息 · 回到底部 ↓</button>
    <view class="composer" wx:if="{{group || member.canMessage}}"><textarea auto-height adjust-position="{{false}}" show-confirm-bar="{{false}}" confirm-type="send" cursor-spacing="18" maxlength="2000" data-field="text" value="{{text}}" bindinput="input" bindlinechange="measureMessages" bindconfirm="send" aria-label="消息内容" placeholder="发消息…"/><button class="primary" bindtap="send" loading="{{working}}" disabled="{{!text || working}}" hover-class="press-feedback">发送</button></view>
    <view wx:elif="{{member && !member.canMessage}}" class="note chat-restricted">当前无法发送私信，可到鸟友主页查看好友关系与私信权限。</view>
  </block>
  <block wx:elif="{{screen === 'blocked'}}"><view wx:if="{{!blocked.length}}" class="muted">屏蔽名单为空。</view><view class="line card" wx:for="{{blocked}}" wx:key="id"><text>{{item.nickname}}</text><button data-op="unblock" data-id="{{item.id}}" bindtap="mutate">解除屏蔽</button></view></block>
</view>

<view wx:if="{{settingsOpen}}" class="social-shade" catchtap="closeSettings" catchtouchmove="stopTouch"/>
<view wx:if="{{settingsOpen}}" class="social-settings sheet-frame" style="{{sheetDragStyle}}" aria-role="dialog" aria-label="会话设置">
  <view class="sheet-header-fixed" data-sheet-id="socialSettings" data-dismiss="closeSettings" catchtouchstart="sheetDragStart" catchtouchmove="sheetDragMove" catchtouchend="sheetDragEnd" catchtouchcancel="sheetDragCancel"><view class="dialog-grip"/><view class="social-sheet-title"><view>{{screen === 'group' ? '群聊资料与设置' : '私信设置'}}</view><button bindtap="closeSettings" aria-label="关闭会话设置"><image src="/assets/icons/close.png"/></button></view></view>
  <scroll-view enhanced bounces="{{false}}" scroll-y class="sheet-scroll" style="height:{{sheetHeights.socialSettings || 340}}px"><view class="sheet-measure social-settings-body" data-sheet-id="socialSettings">
    <view wx:if="{{localError}}" class="note error">{{localError}}</view>
    <view class="settings-label">本机备注<text>只对你可见，不改变对方昵称或群名称。</text></view><view class="alias-editor"><input value="{{aliasDraft}}" data-field="aliasDraft" bindinput="input" maxlength="40" placeholder="方便自己识别的名称"/><button bindtap="saveAlias">保存</button></view>
    <button class="preference-row" data-field="pinned" bindtap="preference"><text>置顶会话</text><text class="preference-value">{{prefs.pinned ? '已置顶' : '未开启'}}</text></button><button class="preference-row" data-field="quiet" bindtap="preference"><text>本机不提示未读</text><text class="preference-value">{{prefs.quiet ? '已开启' : '未开启'}}</text></button>
    <block wx:if="{{group}}"><view class="group-detail-heading"><view>{{group.name}}</view><text>{{group.owner === self ? '我是群主' : '我是群成员'}} · {{group.members.length}} 位鸟友</text></view><input value="{{memberQuery}}" data-field="memberQuery" bindinput="input" placeholder="在群内找鸟友" maxlength="50"/>
      <button class="member-grid-row" wx:for="{{visibleMembers}}" wx:key="id" data-screen="member" data-id="{{item.id}}" bindtap="go"><profile-avatar avatar="{{item.avatar}}" name="{{item.nickname}}" size="34"/><text>{{item.nickname}}</text><text class="member-role">{{item.id === group.owner ? '群主' : '成员'}}</text></button><view wx:if="{{!visibleMembers.length}}" class="tiny">没有匹配的群成员。</view>
      <block wx:if="{{group.owner === self}}"><view class="settings-label">邀请好友<text>对方确认后加入，群主可邀请已有好友。</text></view><view class="group-invite-grid"><button wx:for="{{invitees}}" wx:key="id" disabled="{{working}}" data-id="{{item.id}}" data-op="invite" bindtap="mutate">＋ {{item.nickname}}</button></view><view wx:if="{{!invitees.length}}" class="tiny">暂无可邀请的好友。</view></block>
      <view class="group-permission-copy">当前群主负责邀请与解散，成员可自行退出。更改公开群名、管理员与移出成员功能待服务支持。</view><button class="group-danger" data-op="{{group.owner === self ? 'disband' : 'leave'}}" bindtap="mutate" disabled="{{working}}">{{group.owner === self ? '解散群聊' : '退出群聊'}}</button>
    </block><view class="tiny">备注、置顶、未读提示和未发送文字保存在当前账号的本机空间。</view>
  </view></scroll-view>
</view>
