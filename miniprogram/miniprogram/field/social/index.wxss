.social-empty{padding:32px 16px;text-align:center;color:#596c62;font-size:15px;line-height:1.6}.social-empty>image{display:block;width:32px;height:32px;margin:0 auto 12px;opacity:.8}.social-empty>text{display:block;font-size:13px;margin-top:8px}.compact-social-empty{padding:20px}.friend-search-result{display:flex;width:100%;gap:12px;text-align:left;background:#fff;padding:14px 4px;border-bottom:1px solid #e8edea;border-radius:0}.friend-search-result>view{flex:1;min-width:0}.friend-search-result text{display:block;font-size:15px}.friend-search-result text:last-child{font-size:13px;color:#596c62}.friend-search-result>image{width:14px;height:14px;flex:none}
