.social-section-copy{font-size:21px;font-weight:600;margin:20px 0 12px;line-height:1.4}.social-section-copy text{display:block;font-size:13px;font-weight:400;color:#596c62;line-height:1.65;margin-top:6px}
.friend-card{padding:16px;background:#fff;border-radius:20px;margin:10px 0}.friend-identity{display:flex;align-items:center;gap:12px;min-height:48px}.friend-identity>view{flex:1;min-width:0}.friend-name,.friend-handle{display:block;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.friend-name{font-size:16px;font-weight:600}.friend-handle{font-size:13px;color:#596c62;margin-top:3px}.friend-state{flex:none;font-size:12px;color:#42634f;background:#eaf2ee;padding:4px 8px;border-radius:8px}
