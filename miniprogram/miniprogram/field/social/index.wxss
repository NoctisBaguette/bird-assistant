.inbox-section-heading{display:flex;align-items:center;justify-content:space-between;gap:12px}.inbox-section-heading button{background:transparent;padding:8px;color:#596c62;font-size:12px}.inbox-entry,.activity-row{position:relative;background:#fff;border-radius:18px;margin:10px 0;overflow:hidden}.inbox-entry.inbox-pinned{background:#e7f0ea}
