/* Conversation height is measured once per window/keyboard change. The history owns scrolling. */
.chat-page{position:fixed;left:0;right:0;width:100%;max-width:860px;display:flex;flex-direction:column;overflow:hidden;padding:0;background:#f0f4f1;min-height:0}
.chat-page>.note{flex:none;margin:8px 16px;max-height:100px;overflow:auto}.chat-heading{display:flex;align-items:center;justify-content:space-between;gap:12px;flex:none;padding:8px 16px;background:#fff;border-bottom:1px solid #e8edea;min-height:56px}.social .chat-peer{display:flex;gap:10px;justify-content:flex-start;flex:1;min-width:0;padding:0;background:transparent;text-align:left;border-radius:0;min-height:40px}.chat-peer>view{flex:1;min-width:0}.chat-peer text,.chat-group-title text{display:block;font-size:15px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-weight:600}.chat-peer text:last-child,.chat-group-title text:last-child{font-size:12px;font-weight:400;color:#596c62}.chat-group-title{flex:1;min-width:0}.social .chat-settings{flex:0 0 44px;width:44px;height:44px;padding:11px;background:#edf2ef;border-radius:50%}.chat-settings image{display:block;width:22px;height:22px;flex:none}
.chat-messages{display:block;flex:1;min-height:0;height:0;width:100%;overflow:hidden}.message-history{padding:12px 16px 20px;min-height:100%;box-sizing:border-box}.social .older-messages{display:block;margin:0 auto 16px;background:transparent;padding:8px;font-size:12px;color:#596c62}.chat-empty{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;min-height:220px;padding:24px;color:#596c62;text-align:center;font-size:16px}.chat-empty image{width:36px;height:36px;opacity:.7}.chat-empty text:last-child{font-size:13px}
.message-row{display:flex;align-items:flex-start;gap:9px;margin:0 0 18px;min-width:0}.message-own{flex-direction:row-reverse}.message-copy{min-width:0;max-width:calc(100% - 76px);display:flex;flex-direction:column;align-items:flex-start}.message-own .message-copy{align-items:flex-end}.message-byline{display:flex;flex-wrap:wrap;gap:6px;font-size:11px;line-height:1.5;color:#596c62;margin:0 2px 4px}.social .bubble{display:block;min-width:0;max-width:100%;padding:11px 14px;border:0;border-radius:4px 17px 17px 17px;background:#fff;font-size:16px;line-height:1.6;white-space:pre-wrap;overflow-wrap:anywhere}.social .bubble.own{border-radius:17px 4px 17px 17px;background:#d5eade;color:#183e2c}.message-end{height:1px}.social .message-share-card{display:block;width:100%;min-width:150px;max-width:100%;background:transparent;border:0;margin:0;padding:2px;text-align:left;white-space:normal;line-height:1.55}.message-share-card>text{display:block;font-size:12px;color:#52675a}.message-share-card>view{font-size:16px;font-weight:600;margin:7px 0;overflow-wrap:anywhere}
