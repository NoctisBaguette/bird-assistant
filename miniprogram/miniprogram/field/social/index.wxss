.social-shade{position:fixed;inset:0;z-index:180;background:#173d2d66}.social-settings{position:fixed;z-index:181;bottom:0;left:0;right:0;max-width:620px;margin:auto;background:#fff;border-radius:24px 24px 0 0;overflow:hidden;box-shadow:0 -8px 40px #203c3010}.social-settings .sheet-header-fixed{padding:14px 18px}.social-sheet-title{display:flex;align-items:center;justify-content:space-between;gap:12px;font-size:20px;font-weight:600}.social-sheet-title button{display:flex;align-items:center;justify-content:center;flex:0 0 40px;width:40px;height:40px;min-height:40px;padding:10px;margin:0;background:#edf2ef;border-radius:50%}.social-sheet-title image{display:block;flex:none;width:20px;height:20px}.social-settings-body{padding:0 18px calc(24px + env(safe-area-inset-bottom));font-size:14px;overflow-wrap:anywhere}.settings-label{font-size:15px;font-weight:600;margin:20px 0 9px}.settings-label text{display:block;font-weight:400;font-size:12px;color:#596c62;line-height:1.65;margin-top:5px}.alias-editor{display:flex;align-items:center;gap:10px;margin:12px 0 20px}.alias-editor input{flex:1;min-width:0;width:0}.alias-editor button{min-height:44px;flex:none;padding:10px 14px;font-size:14px}.preference-row{display:flex;align-items:center;justify-content:space-between;gap:12px;width:100%;min-height:56px;background:transparent;padding:14px 0;border-bottom:1px solid #e5ebe7;border-radius:0;text-align:left;font-size:15px}.preference-value{font-size:13px;color:#596c62;flex:none}.group-detail-heading{margin:24px 0 14px;font-size:22px;font-weight:600}.group-detail-heading text{display:block;font-size:13px;font-weight:400;color:#596c62;margin-top:6px}.member-grid-row{display:flex;align-items:center;gap:12px;width:100%;padding:12px 0;background:transparent;border-radius:0;text-align:left;font-size:15px}.member-grid-row>text{flex:1;min-width:0}.member-grid-row .member-role{flex:none;font-size:12px;padding:4px 8px;color:#42634f;background:#eaf2ee;border-radius:8px}.group-invite-grid{display:flex;flex-wrap:wrap;gap:8px}.group-invite-grid button{font-size:14px;padding:10px 12px}.group-permission-copy{font-size:12px;color:#596c62;line-height:1.7;margin:20px 0}.group-danger{display:block;width:100%;min-height:46px;padding:12px;font-size:14px;color:#914833;background:#fcf0eb;margin:18px 0}.social-settings-body>.tiny{font-size:12px;line-height:1.7;color:#596c62}.dialog-grip{position:absolute;left:calc(50% - 16px);top:7px;width:32px;height:4px;border-radius:4px;background:#c3d1c9;pointer-events:none}
