.social .member-actions{gap:10px;margin:16px 0}.member-actions button{flex:1}.member-actions .member-more{flex:none;background:#fff}.member-tabs{display:flex;gap:20px;margin:20px 0 12px;border-bottom:1px solid #e3eae6}.social .member-tabs button{background:transparent;border-radius:0;padding:10px 2px;min-height:44px;border-bottom:3px solid transparent;color:#596c62}.social .member-tabs .member-tab-active{border-bottom-color:#23664f;color:#23664f;font-weight:600}.member-feed{display:grid;gap:10px}.social .member-post{display:flex;width:100%;gap:12px;padding:12px;background:#fff;border-radius:18px;text-align:left}.member-thumb{display:flex;align-items:center;justify-content:center;width:58px;height:58px;flex:none;background:#eaf2ee;border-radius:12px;overflow:hidden}.member-thumb image{width:100%;height:100%}.member-thumb .member-glyph{width:24px;height:24px}.member-copy{flex:1;min-width:0}.member-copy text{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:15px;font-weight:600}.member-copy view{font-size:12px;color:#596c62;margin-top:3px}.member-arrow{width:14px;height:14px;flex:none}
.forward-preview{padding:18px;background:#fff;border-radius:20px;margin:16px 0}.forward-preview>text{font-size:12px;color:#596c62}.forward-preview>view{font-size:20px;font-weight:600;margin-top:8px}.forward-preview button{background:transparent;font-size:13px}.forward-confirm{position:sticky;top:6px;z-index:3;padding:16px;background:#e6f0ea;border-radius:18px;margin:14px 0}.forward-confirm>view{font-size:14px;margin-bottom:10px}.forward-confirm text{font-weight:600}.social .forward-confirm button{width:100%}.social .forward-target{display:flex;width:100%;gap:12px;padding:14px;background:#fff;border:2px solid transparent;border-radius:18px;text-align:left;margin:10px 0}.forward-target>text{flex:1;min-width:0}.forward-target>image{width:16px;height:16px;flex:none}.forward-target .forward-group{width:36px;height:36px;padding:7px;background:#eaf2ee;border-radius:12px}.social .forward-target.target-picked{border-color:#23664f;background:#eaf2ee}.forward-receipt{padding:14px;background:#e6f0ea;border-radius:14px;color:#23664f;margin:12px 0}
