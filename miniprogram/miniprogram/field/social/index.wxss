/* Social pages share native typography, row alignment and one clear action per task. */
.social{padding-bottom:calc(24px + env(safe-area-inset-bottom));overflow-wrap:anywhere}
.social button{margin:0;min-width:0;font-size:14px;line-height:1.45}
