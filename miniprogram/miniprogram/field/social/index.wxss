.social .composer{position:relative;bottom:auto;display:flex;align-items:flex-end;gap:10px;flex:none;min-height:68px;padding:12px 16px calc(12px + env(safe-area-inset-bottom));background:#fff;border-top:1px solid #e3eae6;z-index:2}.social.keyboard-open .composer{padding-bottom:12px}.social .composer textarea{display:block;flex:1;min-width:0;width:0;min-height:44px;max-height:120px;height:auto;padding:11px 12px;border:0;border-radius:14px;background:#edf2ef;font-size:16px;line-height:22px}.social .composer button{flex:0 0 56px;min-width:56px;max-width:56px;min-height:44px;margin:0;padding:10px 5px;font-size:14px}.chat-restricted{flex:none}
