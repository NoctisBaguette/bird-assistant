<app-header title="{{preview ? '访客预览' : '布置主页'}}" back bindback="back"/>
<view class="page studio"><view wx:if="{{loading}}" class="note">正在读取主页…</view><view wx:if="{{error}}" class="note error">{{error}}<button wx:if="{{!profile}}" bindtap="load">重新读取</button></view>
<block wx:if="{{profile}}"><profile-cover cover="{{layout.landscape}}" custom-image="{{display.coverImage}}" focus="{{layout.focus}}" avatar="{{profile.avatar}}" name="{{profile.nickname}}" subtitle="@{{profile.handle}}" bio="{{profile.bio}}" theme="{{layout.theme}}" tags="{{layout.tags}}" status="{{layout.status}}"/>
<profile-works items="{{display.items}}" theme="{{layout.theme}}" preview/>
<block wx:if="{{!preview}}">
  <view class="studio-head">封面照片</view>
  <button class="quiet wide" disabled="{{picking || saving}}" bindtap="chooseAlbum">从手机相册选择照片</button>
  <view class="muted">保存后，能访问你主页的鸟友可以看到这张封面。</view>
  <view class="chip-row"><button class="{{!albumPath && !layout.coverPhoto && !layout.cover && layout.landscape === 'woodland' ? 'selected' : ''}}" data-field="landscape" data-value="woodland" bindtap="choose">林间枝影</button><button class="{{!albumPath && !layout.coverPhoto && !layout.cover && layout.landscape === 'waterside' ? 'selected' : ''}}" data-field="landscape" data-value="waterside" bindtap="choose">水岸鸟踪</button></view>
  <scroll-view wx:if="{{choices.length}}" scroll-x class="cover-strip"><button wx:for="{{choices}}" wx:key="id" wx:if="{{item.image}}" class="cover-option {{layout.cover === item.id ? 'chosen' : ''}}" aria-label="使用{{item.title}}作封面" data-field="cover" data-value="{{item.id}}" bindtap="choose"><image src="{{item.image}}" mode="aspectFill" lazy-load/></button></scroll-view>
  <text class="label">封面上下取景</text><slider value="{{layout.focus}}" min="0" max="100" bindchange="focus" activeColor="#34674e"/>
  <view class="studio-head">主页配色</view><view class="chip-row"><button wx:for="{{themes}}" wx:key="id" class="{{layout.theme === item.id ? 'selected' : ''}}" data-field="theme" data-value="{{item.id}}" bindtap="choose"><view class="dot dot-{{item.id}}"/>{{item.name}}</button></view>
  <view class="studio-head">我的标签</view><view class="chip-row"><button wx:for="{{tags}}" wx:key="name" class="{{item.selected ? 'selected' : ''}}" data-field="tags" data-value="{{item.name}}" bindtap="choose">{{item.name}}</button></view>
  <view class="studio-head">今日状态 <text>24 小时有效</text></view><view class="chip-row"><button wx:for="{{statuses}}" wx:key="*this" class="{{layout.status === item ? 'selected' : ''}}" data-field="status" data-value="{{item}}" bindtap="choose">{{item || '不展示'}}</button></view>
  <view class="studio-head">精选作品 <text>{{display.items.length}} / 3</text></view><view class="muted">从已公开的署名帖子中挑选，第一项会作为代表作。</view>
  <view wx:for="{{display.items}}" wx:key="id" class="selected-work {{dragId === item.id ? 'lifted' : ''}}" data-id="{{item.id}}" bindlongpress="dragStart" bindtouchend="dragEnd" bindtouchcancel="dragCancel"><text>{{index+1}}　{{item.title}}</text><button wx:if="{{index}}" data-id="{{item.id}}" bindtap="promote">前移</button><button data-field="works" data-value="{{item.id}}" bindtap="choose">移除</button></view>
  <button wx:if="{{previousOrder.length}}" class="text-button" bindtap="undoOrder">撤销排序</button>
  <button wx:for="{{choices}}" wx:key="id" class="work-choice {{item.rank ? 'selected' : ''}}" data-field="works" data-value="{{item.id}}" bindtap="choose"><text>{{item.title || '观鸟手记'}}</text><text>{{item.rank || '＋'}}</text></button><view wx:if="{{!choices.length}}" class="empty">公开一篇署名观察后，就能在这里选作代表作。</view>
  <button class="quiet wide spaced" bindtap="editIdentity">修改昵称、头像与简介</button>
</block><block wx:else><view class="chip-row preview-sections"><button data-tab="posts" bindtap="previewSection">署名发布</button><button wx:if="{{bookmarksVisible}}" data-tab="bookmarks" bindtap="previewSection">公开书签</button></view><view wx:for="{{previewTab === 'bookmarks' && bookmarksVisible ? publicBookmarks : publicPosts}}" wx:key="id" class="preview-post">{{item.title || item.speciesName || '观鸟手记'}}</view><view wx:if="{{previewTab === 'posts' ? !publicPosts.length : !publicBookmarks.length}}" class="empty">暂无公开内容</view></block><view class="studio-footer"><button disabled="{{saving}}" bindtap="back">{{preview ? '返回编辑' : '取消'}}</button><button wx:if="{{!preview}}" bindtap="togglePreview">访客预览</button><button class="primary" loading="{{saving}}" disabled="{{!dirty || saving}}" bindtap="save">保存主页</button></view></block></view>
