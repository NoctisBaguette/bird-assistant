.studio{padding-bottom:calc(100px + env(safe-area-inset-bottom))}.studio-head{font-size:17px;font-weight:600;margin:24px 0 10px}.studio-head text{font-size:12px;font-weight:400;color:#596c60}.chip-row,.selected-work,.studio-footer,.work-choice{display:flex;gap:8px;align-items:center}.chip-row{flex-wrap:wrap}.chip-row button{font-size:13px;min-height:38px;padding:6px 12px;gap:6px}.studio .selected{background:#315d47;color:#fff}.dot{width:12px;height:12px;border:1px solid #fff;border-radius:50%}.dot-forest{background:#51855a}.dot-lake{background:#4585a0}.dot-sunset{background:#bc7055}.cover-strip{white-space:nowrap;margin-top:10px}.cover-option{display:inline-block;width:100px;height:60px;padding:3px;margin-right:6px;background:transparent}.cover-option.chosen{background:#315d47}.cover-option image{width:100%;height:100%;border-radius:9px}.work-choice,.selected-work{width:100%;justify-content:space-between;margin:7px 0;text-align:left}.work-choice text:first-child,.selected-work text{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.selected-work button{padding:4px 8px;font-size:12px}.studio-footer{position:fixed;z-index:4;bottom:0;left:0;right:0;padding:10px 15px calc(10px + env(safe-area-inset-bottom));background:#f4f7f5;border-top:1px solid #dde5dc;justify-content:center}.studio-footer button{flex:1;max-width:180px}
.lifted{background:#e1edde;transform:scale(1.025);box-shadow:0 4px 12px #23443221}.selected-work{transition:transform .15s ease}.preview-sections{margin-top:18px}.preview-post{padding:12px;margin:8px 0;background:#ffffff;border-radius:12px}
