<app-header title="{{view === 'profile' && compactCover && communityName ? communityName : crop ? '裁剪头像' : pageTitle}}" portrait="{{view === 'profile' && compactCover ? communityAvatar : ''}}" back="{{view !== 'profile'}}" bindback="back" />
<view class="page {{focusedPage ? 'focused-page' : ''}}"><block wx:if="{{crop}}"><view class="title">让头像刚刚好</view><view class="subtitle">拖动图片调整位置，圆形外的部分不会显示。</view><view class="crop-stage" catchtouchstart="cropStart" catchtouchmove="cropMove" catchtouchend="cropEnd" catchtouchcancel="cropEnd"><image src="{{cropPath}}" class="crop-image" style="width:{{cropDisplayW}}px;height:{{cropDisplayH}}px;left:{{110+cropX}}px;top:{{110+cropY}}px;transform:translate(-50%,-50%) rotate({{cropRotation}}deg)" /><view class="crop-circle" /></view><view class="value-row"><text>缩放</text><view class="number-field"><input class="number-input" type="text" maxlength="16" value="{{numberEditing === 'cropZoom' ? numberDrafts.cropZoom : cropZoom}}" data-key="cropZoom" bindinput="numberInput" bindblur="numberCommit" bindconfirm="numberCommit" confirm-type="done" aria-label="cropZoom" /><text class="number-unit">×</text></view></view><slider min="1" max="3" step="0.01" value="{{cropZoom}}" bindchanging="cropZoom" bindchange="cropZoom" activeColor="#285b49" /><view class="row between rotation-label"><view class="value-row"><text>旋转</text><view class="number-field"><input class="number-input" type="text" maxlength="16" value="{{numberEditing === 'cropRotation' ? numberDrafts.cropRotation : cropRotation}}" data-key="cropRotation" bindinput="numberInput" bindblur="numberCommit" bindconfirm="numberCommit" confirm-type="done" aria-label="cropRotation" /><text class="number-unit">°</text></view></view><button class="text-button reset-rotation" bindtap="resetCropRotation" disabled="{{cropRotation === 0}}">归零 0°</button></view><view class="choice-row"><button data-delta="-90" bindtap="rotate">向左旋转 90°</button><button data-delta="90" bindtap="rotate">向右旋转 90°</button></view><button class="primary wide spaced" bindtap="useCrop" loading="{{cropBusy}}" disabled="{{cropBusy}}">使用这个裁剪</button><button class="quiet wide spaced" bindtap="cancelCrop" disabled="{{cropBusy}}">取消裁剪</button></block>
<block wx:elif="{{view === 'profile'}}">
  <profile-cover cover="{{identity === 'ready' ? showcase.layout.landscape : cover}}" custom-image="{{showcase.coverImage}}" focus="{{showcase.layout.focus}}" theme="{{showcase.layout.theme}}" tags="{{showcase.layout.tags}}" status="{{showcase.layout.status}}" avatar="{{communityAvatar || 'owl'}}" name="{{communityName || (identity === 'loading' ? '正在读取资料…' : '我的观鸟空间')}}" subtitle="{{handle ? '@' + handle : ''}}" bio="{{bio}}" editable="{{identity !== 'loading'}}" show-cover-button="{{identity === 'ready'}}" bind:coverchange="openStudio" action="{{identity === 'ready' ? '布置主页' : identity === 'offline' ? '重试' : '登录羽迹'}}" bind:profileedit="openStudio"/>
  <button wx:if="{{identityNotice}}" class="text-button" bindtap="retryIdentity">{{identityNotice}}</button>
  <profile-works items="{{showcase.items}}" theme="{{showcase.layout.theme}}"/>
  <view class="profile-shortcuts"><button wx:for="{{quickActions}}" wx:key="id" class="shortcut shortcut-{{item.id}}" data-id="{{item.id}}" data-index="{{index}}" bindlongpress="changeShortcut" bindtap="menu" hover-class="press-feedback"><image src="/assets/icons/{{item.icon}}.png"/>{{item.name}}</button></view>
  <view class="shortcut-hint">长按可更换快捷入口</view>
  <view class="profile-stats" aria-label="本机观察统计"><view><text>{{observationCount}}</text>我的观察</view><view><text>{{speciesCount}}</text>已标注鸟名</view><view><text>{{favoriteCount}}</text>收藏记录</view></view>
  <view class="album-heading"><view class="album-title">观察相册</view><button class="album-link" data-id="{{galleryTab === 'favorites' ? 'collection' : 'history'}}" bindtap="menu">查看全部 ›</button></view>
  <view class="album-tabs"><button class="{{galleryTab === 'recent' ? 'album-active' : ''}}" data-tab="recent" bindtap="selectGallery">最近</button><button class="{{galleryTab === 'favorites' ? 'album-active' : ''}}" data-tab="favorites" bindtap="selectGallery">收藏</button><button class="{{galleryTab === 'birds' ? 'album-active' : ''}}" data-tab="birds" bindtap="selectGallery">鸟种册</button><button class="{{galleryTab === 'calendar' ? 'album-active' : ''}}" data-tab="calendar" bindtap="selectGallery">日历</button></view>
  <block wx:if="{{galleryTab === 'birds'}}"><view wx:if="{{birdTiles.length}}" class="album-grid"><button wx:for="{{birdTiles}}" wx:key="id" class="album-tile" data-id="{{item.id}}" bindtap="speciesRecords"><view class="tile-media"><image wx:if="{{item.path}}" class="tile-picture" src="{{item.path}}" mode="aspectFill" lazy-load/></view><view class="tile-title">{{item.name}}</view><view class="tile-date">{{item.count}} 条观察</view></button></view><view wx:else class="album-empty">在观察中选定鸟种后，就能在这里按鸟种回看。</view></block>
  <view wx:elif="{{galleryTab === 'calendar'}}" class="month-panel"><view class="month-head"><button aria-label="上个月" data-delta="-1" bindtap="monthStep">‹</button><text>{{monthLabel}}</text><button aria-label="下个月" data-delta="1" bindtap="monthStep">›</button></view><view class="month-grid"><text wx:for="{{weekdays}}" wx:key="*this">{{item}}</text><button wx:for="{{cells}}" wx:key="value" disabled="{{!item.marked || !item.current}}" class="{{item.marked && item.current ? 'marked' : ''}}" data-day="{{item.value}}" bindtap="chooseDay">{{item.current ? item.day : ''}}</button></view></view>
  <view wx:elif="{{gallery.length}}" class="album-grid"><button wx:for="{{gallery}}" wx:key="id" class="album-tile" data-id="{{item.id}}" bindtap="openRecord" hover-class="press-feedback">
    <view class="tile-media"><image wx:if="{{item.kind === 'photo' && item.path}}" class="tile-picture" src="{{item.path}}" mode="aspectFill" data-id="{{item.id}}" binderror="galleryImageError"/><image wx:else class="tile-symbol" src="/assets/icons/{{item.kind === 'video' ? 'video' : 'image'}}.png" mode="aspectFit"/></view>
    <view class="tile-title">{{item.name}}</view><view wx:if="{{item.date}}" class="tile-date">{{item.date}}</view></button></view>
  <view wx:else class="album-empty"><image src="/assets/icons/{{galleryTab === 'favorites' ? 'heart' : 'camera'}}.png"/><view><text>{{galleryTab === 'favorites' ? '还没有收藏' : '留下你的第一条观察'}}</text><view>{{galleryTab === 'favorites' ? '在观察详情中点收藏，就能在这里找到。' : '从一张照片开始记录。'}}</view></view><button wx:if="{{galleryTab === 'recent'}}" bindtap="identify">去记录</button></view>
  <view class="stat-note">统计仅含本机真实记录，鸟名按填写名称去重。</view>
  <view wx:for="{{menuGroups}}" wx:for-item="group" wx:key="title" class="profile-menu-group"><view class="profile-group-title">{{group.title}}</view><view class="profile-menu"><button wx:for="{{group.items}}" wx:key="id" class="menu-row" data-id="{{item.id}}" bindtap="menu" hover-class="press-feedback" hover-start-time="0"><view class="menu-icon"><image class="i" src="/assets/icons/{{item.icon}}.png"/></view><text class="menu-label">{{item.name}}</text><image class="menu-arrow" src="/assets/icons/arrow.png"/></button></view></view>
</block>
<block wx:elif="{{view === 'edit'}}"><view class="title">编辑个人资料</view><text class="label">显示名称</text><input value="{{draftName}}" bindinput="changeName" disabled="{{busy}}" /><text class="label">头像</text><view class="row avatar-editor"><profile-avatar avatar="{{draftAvatar}}" name="{{draftName}}" size="64"/><view class="stack"><button class="small-button" disabled="{{busy}}" bindtap="chooseFallback">上传自己的图片</button><button wx:if="{{nativeAvatar}}" class="quiet small-button" open-type="chooseAvatar" bindchooseavatar="chooseAvatar" binderror="avatarError" disabled="{{busy}}">使用系统头像选择</button></view></view><view class="tiny">上传后可移动、缩放、旋转；圆形预览就是显示范围。</view><view class="section-title">也可以选一个默认头像</view><view class="tiny initials-note">姓名头像随名称变化：英文取首字母，中文取开头一到两个字。</view><view class="avatar-grid"><button wx:for="{{avatars}}" wx:key="id" data-id="{{item.id}}" bindtap="chooseDefault" disabled="{{busy}}"><profile-avatar avatar="{{item.id}}" name="{{draftName}}" size="51"/><text>{{item.name}}</text></button></view><button class="primary wide spaced" bindtap="save" loading="{{busy}}" disabled="{{busy}}">保存资料</button><button class="quiet wide spaced" bindtap="cancel" disabled="{{busy}}">取消修改</button></block>
<block wx:elif="{{view === 'history' || view === 'collection'}}"><view class="title">{{pageTitle}}</view><view class="subtitle">自己的记录可以一直保持私密。</view><view wx:for="{{shownRecords}}" wx:key="id" class="record" data-id="{{item.id}}" bindtap="openRecord"><image wx:if="{{!item.mediaKind || item.mediaKind === 'photo'}}" class="record-image" src="{{item.imagePath}}" mode="aspectFill" /><image wx:else class="record-image media-thumb" src="/assets/icons/{{item.mediaKind === 'video' ? 'video' : 'mic'}}.png" /><view class="record-copy"><view class="strong">{{item.birdName}}</view><view class="record-note">{{item.notes || '暂未填写观察笔记'}}</view><view class="tiny">{{item.sample ? '示例插画' : '私人记录'}} · {{item.timeLabel === '未知' ? '观察时间未知' : item.timeLabel}}</view></view><image class="i" src="/assets/icons/arrow.png" /></view><view wx:if="{{!shownRecords.length}}" class="empty">这里还没有记录。<view>保存的观察与自己的收藏会分别出现在这里。</view></view></block>
<block wx:elif="{{view === 'detail'}}"><image wx:if="{{!detail.mediaKind || detail.mediaKind === 'photo'}}" class="detail-photo" src="{{detail.imagePath}}" mode="aspectFit" data-id="{{detail.id}}" bindtap="preview" /><video wx:elif="{{detail.mediaKind === 'video'}}" class="detail-photo" src="{{detail.imagePath}}" controls /><view class="title spaced">{{detail.birdName}}</view><text class="pill">{{detail.sample ? '示例插画记录' : '私人原始记录'}}</text><view wx:if="{{detail.analysis}}" class="note"><view class="strong">模型线索 · {{detail.analysis.model.name}}</view><view>{{detail.analysis.state === 'candidate' ? '候选供人工复核' : '暂未可靠识别'}}</view><view wx:for="{{detail.targetConfirmations}}" wx:key="rank">目标 {{item.rank}} · {{item.analysis === detail.analysis.analysisId ? '我已确认' : '上次判断'}}：{{item.name}}</view></view><button wx:if="{{!detail.sample && detail.mediaKind !== 'video'}}" class="wide spaced" bindtap="reviewLocal">查看候选与继续复核</button><view class="note">{{detail.notes || '没有填写观察笔记'}}</view><view class="metadata"><view><text>观察时间</text><text>{{detail.timeLabel}}</text></view><view><text>观察地点</text><text>{{detail.placeLabel}}</text></view><view><text>天气</text><text>未知</text></view><view><text>保存时间</text><text>{{detail.savedLabel}}</text></view></view><view class="tiny">{{detail.timeSource === 'manual' || detail.placeSource === 'manual' ? '观察日期、时刻或地点由本人填写。' : '尚未补充观察时间与地点。'}}</view><button class="wide spaced" bindtap="favorite">加入 / 移出我的收藏</button><block wx:if="{{!detail.sample && (!detail.mediaKind || detail.mediaKind === 'photo')}}"><button wx:if="{{detail.communityDraft.species}}" bindtap="localSpecies">查看鸟种图鉴</button>
<view wx:for="{{localChannels}}" wx:key="id">{{item.channel === 'map' ? '地图' : '讨论'}} · {{item.status === 'pending' ? '待审核' : item.status === 'approved' ? '已公开' : item.status === 'withdrawn' ? '已撤回' : '审核未通过'}}<text wx:if="{{item.reason}}"> · {{item.reason}}</text></view>
<view wx:if="{{localStatusError}}" class="tiny">{{localStatusError}}</view><button class="wide spaced" bindtap="localShare">{{localCloudId ? '查看云端观察与公开进度' : '分享到讨论或地图'}}</button></block></block>
<block wx:elif="{{view === 'places'}}"><view class="title">收藏地点</view><view class="subtitle">把想去的观鸟地点留在这里，点击即可在首页地图居中查看。</view><button class="primary wide button-with-icon" bindtap="addPlace" loading="{{placesBusy}}" disabled="{{placesBusy}}" hover-class="press-feedback"><image class="inline-symbol" src="/assets/icons/plus.png"/>收藏一个地点</button><view class="tiny spaced">仅保存在本机。收藏地点不会标记为已到访，也不会公开你的位置。</view><view wx:for="{{savedPlaces}}" wx:key="id" class="card place-card"><view class="row between"><view class="strong">{{item.name}}</view><image class="place-icon" src="/assets/icons/pin.png"/></view><view wx:if="{{item.address}}" class="muted">{{item.address}}</view><view class="tiny">收藏更新 {{item.dateLabel}}</view><view class="choice-row"><button class="quiet" data-id="{{item.id}}" bindtap="openPlace" hover-class="press-feedback">在地图查看</button><button class="text-button" data-id="{{item.id}}" bindtap="deletePlace">移除收藏</button></view></view><view wx:if="{{!savedPlaces.length}}" class="empty compact-empty"><image src="/assets/icons/pin.png"/><view>还没有收藏地点</view><text>选一处地点，下次从这里继续。</text></view></block>
<block wx:elif="{{view === 'saved'}}"><view class="title">保存的他人内容</view><view class="subtitle">书签不计入本人观察的鸟种。</view><view wx:for="{{savedPosts}}" wx:key="id" class="card"><view class="strong">{{item.title}}</view><view class="tiny">讨论书签 · 示例</view></view><view wx:if="{{!savedPosts.length}}" class="empty">还没有书签。可在讨论帖子中点击保存。</view></block>
<block wx:elif="{{view === 'settings'}}"><view class="title">设置与缓存</view><view class="card"><view class="strong">本机空间</view><view class="muted">当前 storage 使用约 {{storageKB}} KB</view><view class="tiny spaced">不包含系统相册与所有持久媒体文件。</view><view class="settings-divider"/><view class="strong">手帐预览缓存</view><view wx:if="{{cacheInfo}}" class="muted">{{cacheInfo.files}} 张可清理预览 · 约 {{cacheInfo.kilobytes}} KB</view><view class="tiny spaced">缩略图与列表索引可重新生成。清理会保留手帐、撤销历史、草稿、AI建议、原图与账号。</view><view wx:if="{{cacheInfo.protectedFiles}}" class="tiny">另有 {{cacheInfo.protectedFiles}} 个被已保存内容引用的文件，予以保留。</view><button class="quiet wide spaced" disabled="{{!cacheInfo || (!cacheInfo.files && !cacheInfo.entries)}}" bindtap="cleanPreviewCache" hover-class="press-feedback">清理预览缓存</button><view wx:if="{{cacheNotice}}" class="tiny spaced" aria-live="polite">{{cacheNotice}}</view><view wx:if="{{cacheError}}" class="note error">{{cacheError}}</view></view><view class="card"><view class="strong">手机AI写作连接</view><view class="muted spaced">检查线上服务是否就绪，不生成建议，也不发送照片或草稿文字。</view><button class="quiet wide spaced" bindtap="checkWriting" loading="{{writingChecking}}" disabled="{{writingChecking}}">检查线上写作服务</button><view wx:if="{{writingStatus}}" class="note {{writingReady ? '' : 'error'}}" aria-live="polite">{{writingStatus}}</view><button wx:if="{{writingStatus && !communityName}}" class="text-button" data-id="account" bindtap="menu">打开社区账号</button></view><view class="note">本机内容不会自动跨设备同步。需分享的手帐可导出整页图片，或加入帖子草稿后发布。</view><view class="card"><view class="strong">问题反馈</view><view class="muted spaced">复制设备、版本与最近的故障分类，帮助复现问题。摘要不包含照片、文字内容、地点或密钥。</view><button class="quiet wide spaced" bindtap="copyDiagnostics">复制故障摘要</button></view></block>
<view wx:if="{{error}}" class="note error">{{error}}</view></view>
<canvas id="avatar-export" type="2d" class="avatar-export" />
