<app-header title="{{view === 'feed' ? '鸟友讨论' : '写一篇帖子'}}" back="{{view !== 'feed'}}" bindback="back"/>
<scroll-view class="forum-scroll" scroll-y style="height:{{feedHeight}}px" refresher-enabled="{{view === 'feed'}}" refresher-threshold="64" refresher-default-style="none" refresher-background="#fafbf5" refresher-triggered="{{refreshing}}" bindrefresherpulling="pulling" bindrefresherrefresh="pullRefresh" bindrefresherrestore="pullReset" bindrefresherabort="pullReset" bindscrolltolower="onReachBottom">
<view slot="refresher" class="pull-refresh" aria-role="status"><view class="flight-loader pull-flight {{refreshing ? 'is-flying' : ''}}" style="opacity:{{refreshing ? 1 : pullProgress}}"><view class="flight-bird bird-one"/><view class="flight-bird bird-two"/><view class="flight-bird bird-three"/></view><text>{{refreshing ? '鸟讯正在归来…' : pullReady ? '松开，迎接新鸟讯' : '下拉，看看新的发现'}}</text></view>
<view class="page forum-page {{focusedPage ? 'focused-page' : ''}}"><block wx:if="{{view === 'feed'}}">
<view class="forum-topbar"><text class="forum-caption">分享观察，一起辨鸟</text><view class="forum-tools"><button class="new-post" bindtap="compose">＋ 发帖</button></view></view>
<view class="forum-tabs"><view class="forum-tab selected">最新讨论</view><button class="forum-tab" data-screen="mine" bindtap="section">我的发布</button><button class="forum-tab" data-screen="bookmarks" bindtap="section">我的收藏</button><button class="forum-tab" bindtap="moreSections" aria-expanded="{{moreOpen}}">更多 ···</button></view>
<view wx:if="{{error}}" class="forum-error">{{error}}<button class="inline-retry" bindtap="refreshFeed">重试</button></view>
<view wx:if="{{feedLoading && !remotePosts.length}}" class="feed-status">正在加载讨论…</view>
<view wx:for="{{remotePosts}}" wx:key="id" class="post-card" data-screen="record" data-id="{{item.id}}" bindtap="section"><view class="post-author"><view class="author-avatar">{{item.initial}}</view><view class="author-copy"><text class="author-name">{{item.publicName}}</text><text class="post-time">发布于 {{item.posted || '时间未注明'}}</text></view><text wx:if="{{item.speciesId}}" class="post-topic">鸟种话题</text></view>
<view class="post-open" data-id="{{item.id}}" data-screen="record" catchtap="section"><view class="post-copy"><view class="post-title">{{item.title || '分享一条观察'}}</view><view wx:if="{{item.body}}" class="post-body">{{item.body}}</view></view></view>
<view wx:if="{{item.gallery.length}}" class="post-media-grid"><view wx:for="{{item.gallery}}" wx:for-item="media" wx:for-index="mediaIndex" wx:key="image" class="post-media-item"><button class="post-media-square" data-id="{{item.id}}" data-index="{{mediaIndex}}" catchtap="previewPost" aria-label="查看第{{mediaIndex+1}}张图片"><image src="{{media.image}}" mode="aspectFill"/><text wx:if="{{media.kind === 'journal'}}" class="post-media-badge">手帐</text></button></view></view><view class="post-actions"><button class="post-action {{item.liked ? 'is-on' : ''}}" data-id="{{item.id}}" data-kind="like" catchtap="react" hover-class="post-action-hover" hover-stop-propagation aria-busy="{{item.likePending}}" aria-pressed="{{item.liked}}"><image class="action-icon" src="/assets/icons/heart.png"/><text>{{item.liked ? '已赞' : '赞'}}{{item.hasLikes ? ' '+item.likes : ''}}</text></button><button class="post-action" data-id="{{item.id}}" data-screen="record" catchtap="section"><image class="action-icon" src="/assets/icons/chat.png"/><text>回复{{item.hasReplies ? ' '+item.replyCount : ''}}</text></button><button class="post-action {{item.favorited ? 'is-on' : ''}}" data-id="{{item.id}}" data-kind="bookmark" catchtap="react" hover-class="post-action-hover" hover-stop-propagation aria-busy="{{item.bookmarkPending}}" aria-pressed="{{item.favorited}}"><image class="action-icon" src="/assets/icons/collection.png"/><text>{{item.favorited ? '已收藏' : '收藏'}}</text></button></view></view>
<view wx:if="{{!remotePosts.length && !feedLoading && !error}}" class="forum-empty"><image class="empty-chat" src="/assets/icons/chat.png"/><text class="empty-title">这里还没有公开讨论</text><text>分享一条观察，或向鸟友提个问题。</text><button class="new-post" bindtap="compose">写第一篇帖子</button></view>
<button wx:if="{{more}}" class="feed-more" bindtap="nextPage" loading="{{feedLoading}}" disabled="{{feedLoading}}">加载更多讨论</button><view wx:elif="{{remotePosts.length}}" class="feed-status">已看到本次列表的末尾 · 下拉可刷新</view>
</block><block wx:else><view class="compose-intro">把观察、问题或故事写下来</view><input disabled="{{busy}}" class="compose-title" maxlength="100" value="{{title}}" data-key="title" bindinput="change" placeholder="标题（选填）"/><textarea disabled="{{busy}}" class="compose-body" auto-height maxlength="2000" value="{{body}}" data-key="body" bindinput="change" placeholder="想和鸟友聊些什么？"/><view class="compose-counter">{{body.length}} / 2000</view><view class="compose-tools"><button class="compose-tool" disabled="{{busy || picking || attachments.length >= mediaLimit}}" bindtap="attach"><image class="tool-icon" src="/assets/icons/image.png"/>添加照片</button><button class="compose-tool" disabled="{{busy || picking}}" bindtap="chooseJournals"><image class="tool-icon" src="/assets/icons/journal.png"/>添加手帐</button><button class="compose-tool ai-button" disabled="{{busy || picking}}" bindtap="openWriting">✧ AI 辅助写作</button></view><view class="compose-media-caption">照片与手帐 {{attachments.length}} / {{mediaLimit}} · 手帐最多{{journalLimit}}份</view><view class="post-media-grid"><view wx:for="{{attachments}}" wx:key="id" class="post-media-item"><button class="post-media-square" data-id="{{item.id}}" bindtap="previewAttachment" aria-label="查看{{item.label}}"><image wx:if="{{item.path}}" src="{{item.path}}" mode="aspectFill"/><text wx:else class="post-media-missing">照片待重选</text><text wx:if="{{item.kind === 'journal'}}" class="post-media-badge">手帐</text></button><button class="post-media-remove" disabled="{{busy}}" data-id="{{item.id}}" catchtap="removeAttachment" aria-label="移除{{item.label}}">×</button><button wx:if="{{item.kind === 'photo'}}" class="post-media-details {{activeAttachment === item.id ? 'is-selected' : ''}}" data-id="{{item.id}}" bindtap="attachmentDetails">第{{index+1}}张 · 参数</button><text wx:else class="post-media-label">{{item.label}}</text></view></view><view wx:if="{{attachments.length}}" class="tiny">轻点查看完整图片；手帐分享为成品图，原手帐仍可继续编辑。</view><photo-editor wx:if="{{activeAttachment && activeKind === 'photo'}}" file-info="{{activeMetadata}}" value="{{manualCamera}}" disabled="{{busy}}" bindchange="photoDetails"/><view class="compose-footer"><button class="save-post" bindtap="saveDraft" loading="{{busy}}" disabled="{{busy || picking}}">保存草稿</button><button class="publish-post" disabled="{{busy || picking}}" bindtap="publish">下一步：发布预览</button></view><text class="compose-note">预览后再确认公开；私人观察独立保存。</text><view wx:if="{{error}}" class="forum-error">{{error}}</view></block></view>
</scroll-view>

<view wx:if="{{moreOpen}}" class="forum-menu-backdrop" catchtap="closeMore" catchtouchmove="holdMenu"/>
<view wx:if="{{moreOpen}}" class="forum-menu" aria-role="dialog" aria-label="更多讨论工具" catchtouchmove="holdMenu"><view class="menu-handle"/><view class="menu-heading"><view><text class="menu-title">继续发现</text><text class="menu-subtitle">资料、鸟友，还有未写完的故事</text></view><button class="menu-close" bindtap="closeMore" aria-label="关闭更多工具">×</button></view><view class="menu-grid"><button wx:for="{{moreItems}}" wx:key="id" class="menu-item" data-id="{{item.id}}" bindtap="moreSection"><view class="menu-icon-wrap"><image class="menu-icon" src="/assets/icons/{{item.icon}}.png"/></view><view class="menu-copy"><text class="menu-label">{{item.label}}</text><text class="menu-hint">{{item.hint}}</text></view></button></view><button class="menu-dismiss" bindtap="closeMore">回到讨论</button></view>

<view wx:if="{{writingOpen}}" class="modal-backdrop" catchtap="closeWriting" />
<scroll-view wx:if="{{writingOpen}}" scroll-y class="post-writing-sheet"><view class="post-writing-body"><view class="handle" /><view class="row between"><view class="section-title">✧ 帖子写作助手</view><button class="icon-button" bindtap="closeWriting" aria-label="关闭写作助手"><image class="i" src="/assets/icons/close.png" /></button></view><view class="muted">先留下你的观察和想法，再整理成适合分享的文字。</view><view class="label">想怎么写</view><picker range="{{writingPurposes}}" value="{{writingPurpose}}" bindchange="writingPurpose"><view class="select-field">{{writingPurposes[writingPurpose]}}<view class="chevron" /></view></picker><view class="label">补充想法或要求</view><textarea auto-height value="{{writingInstructions}}" bindinput="writingInstructions" maxlength="1200" placeholder="如：想问鸟友是不是同一种鸟，语气自然一点，不补写未知地点。" /><button class="text-button" bindtap="toggleWritingVoice">{{writingVoice ? '收起语音输入' : '语音补充想法'}}</button><speech-note wx:if="{{writingVoice}}" id="post-speech" accepted-id="{{writingSpeechApplied}}" bindconfirm="confirmWritingSpeech"/><button wx:if="{{image}}" class="writing-image-option" bindtap="writingImage" aria-pressed="{{writingIncludeImage}}"><view class="writing-checkbox">{{writingIncludeImage ? '✓' : ''}}</view><image src="{{image}}" mode="aspectFill" /><text>关联当前照片</text></button><view class="note">生成时会将当前标题、正文、写作要求及明确勾选的照片副本发送至团队 Qwen 网关。建议先预览，再由你应用和发布。</view><view wx:if="{{writingSummary}}" class="writing-summary">{{writingSummary}}</view><view wx:if="{{writingError}}" class="note error">{{writingError}}</view><button class="ai-button wide spaced" loading="{{writingBusy}}" disabled="{{writingBusy}}" bindtap="prepareWriting">生成写作建议</button><view wx:if="{{writingSuggestion}}" class="note"><view class="strong">{{writingSuggestion.title}}</view><view>{{writingSuggestion.body}}</view><button class="primary wide spaced" bindtap="applyWriting">采用建议，返回编辑</button></view><button class="quiet wide spaced" bindtap="closeWriting">返回帖子继续编辑</button></view></scroll-view>

<canvas id="journal-ai-canvas" type="2d" class="post-ai-canvas" />

<view wx:if="{{journalPicker}}" class="modal-backdrop" catchtap="closeJournals"/>
<scroll-view wx:if="{{journalPicker}}" scroll-y class="post-writing-sheet"><view class="post-writing-body"><view class="row between"><text class="section-title">添加手帐成品</text><button class="icon-button" disabled="{{busy}}" bindtap="closeJournals" aria-label="关闭手帐选择">×</button></view><view class="tiny">最多3份；与照片合计不超过9张。只分享成品图。</view><view wx:if="{{!journalChoices.length}}" class="note">没有可添加的已保存手帐。先到「手帐」保存作品，或从相册添加已导出的成品图。</view><button wx:for="{{journalChoices}}" wx:key="id" class="post-journal-choice" disabled="{{busy}}" data-id="{{item.id}}" bindtap="toggleJournal" aria-pressed="{{item.selected}}"><image wx:if="{{item.cover}}" src="{{item.cover}}" mode="aspectFill"/><text>{{item.title}}</text><text>{{item.selected ? '✓' : '＋'}}</text></button><button class="primary wide spaced" loading="{{busy}}" disabled="{{busy || !journalChosen}}" bindtap="addJournals">添加{{journalChosen || ''}}份成品图</button><view wx:if="{{error}}" class="forum-error">{{error}}</view></view></scroll-view>
<canvas id="post-journal-export" type="2d" class="post-ai-canvas" />
